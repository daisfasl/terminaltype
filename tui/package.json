{
  "name": "tui",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "predev": "bun run build:content",
    "dev": "bun --watch src/cli.tsx",
    "prestart": "bun run build:content",
    "start": "bun run src/cli.tsx",
    "pretypecheck": "bun run build:content",
    "typecheck": "tsc --noEmit",
    "build:content": "bun run scripts/build-content-db.ts",
    "build:binary": "bun run build:content && bun build src/cli.tsx --compile --outfile dist/terminaltype"
  },
  "keywords": [],
  "author": "",
  "license": "GPL-3.0-only",
  "type": "module",
  "dependencies": {
    "ink": "^7.1.1",
    "ink-big-text": "^2.0.0",
    "ink-gradient": "^4.0.1",
    "ink-text-input": "^6.0.0",
    "react": "^19.2.8",
    "react-devtools-core": "^8.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
